@model Project.Pages.ViewModels.HomeVehicleCardViewModel
@{
    var imageSrc = VehicleImageHelper.Normalize(Model.MidiaUrl);
    var fallbackImage = VehicleImageHelper.DefaultVehicleImage;
    var imageLoading = (ViewData["VehicleCardLoading"] as string) ?? "lazy";
    var fetchPriority = (ViewData["VehicleCardFetchPriority"] as string) ?? (imageLoading == "eager" ? "high" : "auto");
}
<article class="vehicle-card catalog-card">
    <a class="card-link-cover" aria-label="Abrir detalhes de @Model.Titulo" href="/veiculo/@Model.Id/" data-track-vehicle-click="true" data-vehicle-id="@Model.Id"></a>
    <div class="vehicle-media is-loading">
        <img src="@imageSrc"
             alt="@Model.Titulo"
             class="vehicle-thumb"
             data-progressive-image="true"
             width="640"
             height="480"
             loading="@imageLoading"
             decoding="async"
             fetchpriority="@fetchPriority"
             onerror="this.onerror=function(){var frame=this.closest('.vehicle-media');if(frame){frame.classList.add('is-fallback');}this.hidden=true;};this.removeAttribute('srcset');this.src='@fallbackImage';" />
        <span class="vehicle-placeholder" aria-hidden="true">
            <span class="vehicle-placeholder-icon">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M5 11h14l-1.2-3.2A2 2 0 0 0 15.9 6H8.1a2 2 0 0 0-1.9 1.8L5 11zm-.5 1.5A2.5 2.5 0 0 0 2 15v2h2v1a2 2 0 0 0 4 0v-1h8v1a2 2 0 0 0 4 0v-1h2v-2a2.5 2.5 0 0 0-2.5-2.5h-15zM6.5 16A1.5 1.5 0 1 1 8 14.5 1.5 1.5 0 0 1 6.5 16zm11 0a1.5 1.5 0 1 1 1.5-1.5A1.5 1.5 0 0 1 17.5 16z" />
                </svg>
            </span>
        </span>
        <span class="vehicle-tag">@(Model.Destaque ? "Destaque" : Model.Disponivel ? "Disponível" : "Indisponível")</span>
    </div>
    <div class="vehicle-body">
        <div class="vehicle-name">@Model.Titulo</div>
        <div class="catalog-highlight-text">@Model.Cor - @Model.AnoExibicao</div>
        <div class="catalog-specs"><span>@Model.Cambio</span><span>@Model.Combustivel</span></div>
        @if (Model.ZeroKm)
        {
            <div class="vehicle-meta">0 km</div>
        }
        <div class="vehicle-price">@(Model.Preco <= 0 ? "Consulte" : Model.Preco.ToString("C"))</div>
        <div class="catalog-actions d-grid gap-2">
            <button type="button" class="btn btn-outline-brand w-100" data-whatsapp-modal="true" data-vehicle-title="@Model.Titulo" data-track-vehicle-click="true" data-vehicle-id="@Model.Id">Tenho interesse</button>
        </div>
    </div>
</article>
