@page "/Admin/Cadastros/Marcas/Upsert/{id:int?}"
@model Project.Pages.Admin.Cadastros.Marcas.UpsertModel

@{
    ViewData["Title"] = Model.PageTitle;
}

<style>
    :root { --brand-primary: #9f0a10; --brand-primary-dark: #86080d; --brand-dark: #222222; --brand-border: #ececec; --brand-muted: #6c757d; --brand-card-shadow: 0 8px 24px rgba(0,0,0,.05); }
    .page-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .page-title { font-size: 1.4rem; font-weight: 700; color: var(--brand-dark); margin: 0; }
    .page-subtitle { font-size: .92rem; color: var(--brand-muted); margin: .2rem 0 0; }
    .form-card { background: #fff; border: 1px solid var(--brand-border); border-radius: 1rem; box-shadow: var(--brand-card-shadow); overflow: hidden; }
    .form-card-body { padding: 1.25rem; }
    .section-title { font-size: 1rem; font-weight: 700; color: var(--brand-dark); margin-bottom: .2rem; }
    .section-subtitle { font-size: .85rem; color: var(--brand-muted); margin-bottom: 1rem; }
    .form-label { font-size: .84rem; font-weight: 700; color: var(--brand-dark); margin-bottom: .35rem; }
    .form-control { border-radius: .85rem; border: 1px solid #e6e6e6; min-height: 46px; box-shadow: none !important; }
    .form-control:focus { border-color: rgba(159,10,16,.35); box-shadow: 0 0 0 .2rem rgba(159,10,16,.08) !important; }
    .text-danger { font-size: .8rem; }
    .logo-preview { width: 96px; height: 96px; object-fit: contain; border: 1px solid #e6e6e6; border-radius: .85rem; padding: .4rem; }
    .btn-brand, .btn-soft-dark { border-radius: .85rem; font-weight: 600; min-height: 46px; padding: 0 1.25rem; display: inline-flex; justify-content: center; align-items: center; }
    .btn-brand { background: var(--brand-primary); border-color: var(--brand-primary); color: #fff; }
    .btn-brand:hover { background: var(--brand-primary-dark); border-color: var(--brand-primary-dark); color: #fff; }
    .btn-soft-dark { background: #fff; border: 1px solid var(--brand-border); color: var(--brand-dark); text-decoration: none; }
    .btn-soft-dark:hover { background: #f8f8f8; color: var(--brand-dark); }
    @@media (max-width: 768px) { .page-header { flex-direction: column; align-items: stretch; } }
</style>

<div class="container-fluid">
    <div class="page-header">
        <div>
            <h1 class="page-title"><i class="bi bi-tags-fill me-2"></i>@Model.PageTitle</h1>
            <p class="page-subtitle">@Model.PageSubtitle</p>
        </div>
        <a href="/Admin/Cadastros/Marcas" class="btn btn-soft-dark"><i class="bi bi-arrow-left me-2"></i>Voltar</a>
    </div>

    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Marca.Id">
        <div class="form-card">
            <div class="form-card-body">
                <div class="section-title">Dados da marca</div>
                <div class="section-subtitle">Preencha as informações principais para exibição e filtros.</div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Marca.Nome"></label>
                        <input asp-for="Marca.Nome" class="form-control" maxlength="100">
                        <span asp-validation-for="Marca.Nome" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="LogoArquivo"></label>
                        <input asp-for="LogoArquivo" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" aria-describedby="logoHelp">
                        <span asp-validation-for="LogoArquivo" class="text-danger"></span>
                        <div id="logoHelp" class="form-text">JPG, PNG ou WebP, até 5 MB. Para manter a logo atual, não selecione outro arquivo.</div>
                        <div class="mt-3">
                            <img id="logoPreview" src="@Model.CurrentLogoUrl" class="logo-preview" alt="Prévia da logo" hidden="@(string.IsNullOrWhiteSpace(Model.CurrentLogoUrl))" onerror="this.hidden=true;this.nextElementSibling.hidden=false;">
                            <span id="logoPlaceholder" class="text-muted" hidden="@(!string.IsNullOrWhiteSpace(Model.CurrentLogoUrl))">Sem logo</span>
                        </div>
                        @if (!ViewData.ModelState.IsValid && Model.LogoArquivo is not null)
                        {
                            <div class="form-text">Selecione a imagem novamente antes de tentar salvar.</div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 flex-wrap mt-4">
                    <a href="/Admin/Cadastros/Marcas" class="btn btn-soft-dark">Cancelar</a>
                    <button type="submit" class="btn btn-brand"><i class="bi bi-check2-circle me-2"></i>@Model.SubmitLabel</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('LogoArquivo');
            const preview = document.getElementById('logoPreview');
            const placeholder = document.getElementById('logoPlaceholder');
            const initialUrl = preview.getAttribute('src');
            let objectUrl = null;
            input.addEventListener('change', () => {
                if (objectUrl) URL.revokeObjectURL(objectUrl);
                objectUrl = null;
                input.setCustomValidity('');
                const file = input.files[0];
                if (file && (file.size > @Project.Pages.Admin.Cadastros.Marcas.UpsertModel.MaxLogoBytes || !/\.(jpe?g|png|webp)$/i.test(file.name))) {
                    input.setCustomValidity('Selecione uma imagem JPG, PNG ou WebP de até 5 MB.');
                }
                const source = file && !input.validationMessage ? (objectUrl = URL.createObjectURL(file)) : initialUrl;
                preview.hidden = !source;
                placeholder.hidden = !!source;
                if (source) preview.src = source;
                else preview.removeAttribute('src');
            });
            window.addEventListener('pagehide', event => { if (!event.persisted && objectUrl) URL.revokeObjectURL(objectUrl); });
        })();
    </script>
}
