@page
@model Project.Pages.ResetPasswordModel
<div class="container py-5">
    <h1>Escolher nova senha</h1>
    @if (Model.Completed)
    {
        <p>Senha atualizada. <a asp-page="/Login">Entrar</a></p>
    }
    else
    {
        <p>Use pelo menos 12 caracteres, com maiúscula, minúscula, número e símbolo.</p>
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Code" />
            <label asp-for="Password">Nova senha</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <label asp-for="ConfirmPassword">Confirme a nova senha</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <button type="submit" class="btn btn-primary mt-3">Salvar nova senha</button>
        </form>
    }
</div>
