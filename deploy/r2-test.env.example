# Configuration contract only: no requests and no authorization.
# Explicit approval is required before creating buckets/token/public test base.
# Proposed test bucket: anderson-multimarcas-homologacao (subject to availability).
# Proposed private empty denial control: anderson-multimarcas-homologacao-negativa.
# NEW Object Read & Write token scoped ONLY to the first bucket, with NO access to
# the denial control or any production/shared bucket; no account/bucket admin.
# Keep credentials/destination blank until approved. Never copy production token.
# A prefix does not isolate credentials that can modify the whole shared bucket.
# Real file: private 0600, outside Git/GitHub, without production SQL settings.
Storage__Provider=R2
Storage__DualReadEnabled=true
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=
Storage__R2__PublicBaseUrl=
Storage__R2__ServiceUrl=
Storage__R2__Region=auto

# Run metadata for a reviewed runner, NOT application settings or enforcement.
# Compare test bucket/token/base to production in memory and refuse equality;
# verify provider policy and require an explicit authorization reference.
R2_TEST_AUTHORIZATION_REFERENCE=
R2_TEST_EXPECTED_BUCKET=
R2_TEST_EXPECTED_PUBLIC_BASE_URL=
R2_TEST_DENIAL_CONTROL_BUCKET=
R2_TEST_RUN_PREFIX=uploads/veiculos/r2-acceptance/
R2_TEST_MAX_BYTES=10485760
# Fresh UUID per run; cleanup ONLY keys in that run's explicit manifest.
# Negative checks target ONLY the authorized empty synthetic control bucket.
# No test of any kind may PUT/DELETE production/shared objects.
