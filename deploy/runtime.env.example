# Documentation only. Do not upload as a production env-file without review.
# Docker env-file syntax: raw KEY=value, no export, quotes or shell interpolation.
# Real secrets stay only on the server in shared/runtime.env, mode 0600.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
Database__ApplyMigrationsOnStartup=false
StorageMigration__Execute=false
LegacyImageImport__RecoverPendingJobsOnStartup=false
# Require a dedicated non-sa login with reviewed minimum permissions; no startup DDL.
ConnectionStrings__DefaultConnectionProd=
ConnectionStrings__DefaultConnectionDev=
Storage__Provider=R2
Storage__DualReadEnabled=true
Storage__R2__AccountId=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__BucketName=
Storage__R2__PublicBaseUrl=
Storage__R2__ServiceUrl=
Storage__R2__Region=auto
DataProtection__ApplicationName=AndersonMultiMarcas
DataProtection__KeysPath=/home/app/.aspnet/DataProtection-Keys
Seo__BaseUrl=https://www.andersonmultimarcas.com.br
